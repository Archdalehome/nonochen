{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chen-furniture",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "el_store",
      // `wrangler d1 create el_store` on the chenfurnitureco@gmail.com account.
      "database_id": "ddcc120e-87bc-408a-bbc4-9d2c7f36569a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "el-media"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    // /admin/login signs in with admin/admin out of the box. Replace it without
    // touching the repo (sessions signed with the old password are invalidated):
    //   npx wrangler secret put ADMIN_USER
    //   npx wrangler secret put ADMIN_PASSWORD
    "SITE_NAME": "Chen Furniture",
    "CURRENCY": "GBP",
    "CURRENCY_SYMBOL": "£"
  }
}
